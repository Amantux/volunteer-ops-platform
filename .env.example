# Copy to .env and adjust. NEVER commit real secrets.

# --- Database / Redis (compose sets these to service hostnames automatically) ---
POSTGRES_USER=vop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vop

# --- App ---
VOP_APP_SECRET=generate-a-long-random-string
VOP_BOOTSTRAP_ORG_NAME=Community Volunteers
VOP_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
VOP_PUBLIC_BASE_URL=http://localhost:3000

# --- Email provider ---
# "inbox" (dev, stored in DB) | "console" (dev, logs) | "smtp" (real: Postmark/SES/any SMTP)
VOP_EMAIL_PROVIDER=inbox
VOP_EMAIL_FROM=Community Volunteers <no-reply@example.org>
# For VOP_EMAIL_PROVIDER=smtp (e.g. Postmark: smtp.postmarkapp.com; SES: email-smtp.<region>.amazonaws.com):
VOP_SMTP_HOST=
VOP_SMTP_PORT=587
VOP_SMTP_USERNAME=
VOP_SMTP_PASSWORD=

# --- Payments (donations phase; unused in the training slice) ---
VOP_STRIPE_SECRET_KEY=
VOP_STRIPE_WEBHOOK_SECRET=

# Base URL the BROWSER uses for API calls. Same-origin by default so the
# next.config.js rewrite() proxies /api/* to the backend in dev.
NEXT_PUBLIC_API_BASE=/api

# Base URL the SERVER (SSR / route handlers) uses for API calls. Server-side
# fetches cannot use a relative path, so this must be absolute. Point it at the
# backend directly (in docker-compose, e.g. http://backend:8000/api).
API_INTERNAL_BASE=http://localhost:8000/api

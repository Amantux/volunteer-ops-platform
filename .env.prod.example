# Production env for ONE organization instance. Copy to `.env.prod`, fill in, keep it OUT of git.
# Bring up: docker compose -f compose.prod.yml --env-file .env.prod up -d --build
# The app REFUSES to start if any of these are left insecure (see app/core/production.py).

# --- Domain / TLS (Caddy auto-provisions a cert for this) ---
VOP_DOMAIN=volunteer.example.org

# --- Secrets (generate strong values) ---
# App secret must be >=32 chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
VOP_APP_SECRET=CHANGE_ME_min_32_chars_random_secret
POSTGRES_USER=vop
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=vop

# --- Organization bootstrap (first boot seeds this org + admin) ---
VOP_BOOTSTRAP_ORG_NAME=Riverside Volunteers
VOP_BOOTSTRAP_ORG_SLUG=riverside
VOP_BOOTSTRAP_ADMIN_EMAIL=admin@example.org

# --- Bot protection (required in prod): Cloudflare Turnstile secret ---
VOP_TURNSTILE_SECRET=CHANGE_ME_turnstile_secret

# --- Email (required in prod): a real SMTP relay (Postmark/SES/etc.) ---
VOP_EMAIL_FROM=Riverside Volunteers <no-reply@example.org>
VOP_SMTP_HOST=smtp.example.org
VOP_SMTP_PORT=587
VOP_SMTP_USERNAME=CHANGE_ME
VOP_SMTP_PASSWORD=CHANGE_ME

# --- Optional ---
# VOP_SENTRY_DSN=
# VOP_LLM_PROVIDER=anthropic
# VOP_LLM_API_KEY=

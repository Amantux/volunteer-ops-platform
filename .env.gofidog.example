# Production env for the Golden Opportunities for Independence (GOFI) instance.
# Copy to `.env.gofidog`, fill in the CHANGE_ME values, keep it OUT of git.
# Deploy: docker compose -f compose.prod.yml --env-file .env.gofidog up -d --build
# The app REFUSES to start if any value is left insecure (see app/core/production.py).

# --- Domain / TLS (Caddy auto-provisions a cert; point this DNS record at the VM) ---
VOP_DOMAIN=volunteer.gofidog.org

# --- Secrets ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
VOP_APP_SECRET=CHANGE_ME_min_32_chars_random_secret
POSTGRES_USER=gofi
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=gofi

# --- Organization ---
VOP_BOOTSTRAP_ORG_NAME=Golden Opportunities for Independence
VOP_BOOTSTRAP_ORG_SLUG=gofidog
VOP_BOOTSTRAP_ADMIN_EMAIL=admin@gofidog.org
# Seed GOFI's programs, the Puppy Raiser/Sitter qualifications, the application form + pipeline
# emails, and (in non-prod) sample enrollment + donation campaign.
VOP_SEED_ORG_CONTENT=true

# --- Donations (Stripe hosted checkout). Leave provider=fake until real keys are in place. ---
VOP_PAYMENT_PROVIDER=fake
# VOP_PAYMENT_PROVIDER=stripe
# VOP_STRIPE_SECRET_KEY=sk_test_CHANGE_ME
# VOP_STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# --- Bot protection (Cloudflare Turnstile secret for volunteer.gofidog.org) ---
VOP_TURNSTILE_SECRET=CHANGE_ME_turnstile_secret

# --- Email (a real SMTP relay — Postmark/SES/etc.) ---
VOP_EMAIL_FROM=Golden Opportunities for Independence <no-reply@gofidog.org>
VOP_SMTP_HOST=smtp.example.org
VOP_SMTP_PORT=587
VOP_SMTP_USERNAME=CHANGE_ME
VOP_SMTP_PASSWORD=CHANGE_ME

# --- Optional ---
# VOP_SENTRY_DSN=
